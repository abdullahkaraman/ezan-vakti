{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ezan Vakti",
  "version": "0.2.0",
  "identifier": "com.abdullahkaraman.ezanvakti",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ezan Vakti",
        "width": 320,
        "height": 500,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Bir sonraki ezan vaktine kalan süre",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxQUY2MTAwMTEyMjQ0NzMKUldSelJDSVJBR0d2QVVNNW1HTTBVblE5S2M3N3Jid3UzcDJjZ2NMWGxkcFVlUWh2UU1TUHRCbmsK",
      "endpoints": [
        "https://github.com/abdullahkaraman/ezan-vakti/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
